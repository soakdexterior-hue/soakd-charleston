{
  "name": "AboutMedia",
  "type": "object",
  "properties": {
    "url": {
      "type": "string",
      "description": "Public URL of the photo or video"
    },
    "type": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ],
      "enumColors": [
        "blue",
        "purple"
      ],
      "default": "image",
      "description": "Whether this item is a photo or a video"
    },
    "filename": {
      "type": "string",
      "description": "Original attachment filename"
    },
    "caption": {
      "type": "string",
      "description": "Short caption shown under the media"
    },
    "sort_order": {
      "type": "number",
      "description": "Display order, lowest first"
    },
    "is_published": {
      "type": "boolean",
      "default": true,
      "description": "Show this item on the About page"
    }
  },
  "required": [
    "url",
    "type"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}